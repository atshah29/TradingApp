# Twitter/X API bearer token
bearerToken=your_twitter_bearer_token

# NewsAPI key
newsAPI=your_newsapi_key

# Alpha Vantage key
apiKey=your_alpha_vantage_key

# Python stock updater connection (classic MySQL protocol, not X Protocol)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=trading
